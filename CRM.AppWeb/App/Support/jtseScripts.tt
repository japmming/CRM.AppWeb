<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ output extension="min.js" #>
<#
bool minificar = false;
string rutaInicial = Host.ResolvePath("").Replace(@"\App\Support","");
string rutaBase = rutaInicial + @"\App_Data\_Framework\js\01_Base";
string rutaLibs = rutaInicial + @"\App_Data\_Framework\js\02_Directives";
StringBuilder sb = new StringBuilder();
string[] files = Directory.GetFiles(rutaBase);
string[] filas = null;
sb.Clear();
if(minificar)
	sb.Append("\"use strict\";");
else
	sb.AppendLine("\"use strict\";");
foreach (string file in files)
{	
	filas = File.ReadAllLines(file);
	foreach (string fila in filas) {
		if (!fila.Contains(@"//TODO:")) {
			if(minificar)
				sb.Append(fila.Replace("\"use strict\";","").Replace("\r\n","").Replace("\n","").Replace("\t", ""));
			else
				sb.AppendLine(fila.Replace("\"use strict\";",""));
		}
	}
}
files = Directory.GetFiles(rutaLibs);
foreach (string file in files)
{
	filas = File.ReadAllLines(file);
	foreach (string fila in filas) {
		if (!fila.Contains(@"//TODO:")) {
			if(minificar)
				sb.Append(fila.Replace("\"use strict\";","").Replace("\r\n","").Replace("\n","").Replace("\t", ""));
			else
				sb.AppendLine(fila.Replace("\"use strict\";",""));
		}
	}
}#>
<#=sb.ToString()#>