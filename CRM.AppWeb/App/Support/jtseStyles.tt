<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ output extension="min.css" #>
<#
bool minificar = false;
string rutaInicial = Host.ResolvePath("").Replace(@"\App\Support","");
string rutaBase = rutaInicial + @"\App_Data\_Framework\css\01_Base\";
string rutaLibs = rutaInicial + @"\App_Data\_Framework\css\02_Directives\";
string rutaModules = rutaInicial + @"\App_Data\_Framework\css\03_Modules\";
StringBuilder sb = new StringBuilder();
string[] files = Directory.GetFiles(rutaBase);
string[] filas = null;
sb.Clear();
foreach (string file in files)
{	
	filas = File.ReadAllLines(file);
	foreach (string fila in filas) {
		if(minificar)
			sb.Append(fila.Replace("\r\n","").Replace("\n","").Replace("\t", ""));
		else
			sb.AppendLine(fila);
	}
}
files = Directory.GetFiles(rutaLibs);
foreach (string file in files)
{	
	filas = File.ReadAllLines(file);
	foreach (string fila in filas) {
		if(minificar)
			sb.Append(fila.Replace("\r\n","").Replace("\n","").Replace("\t", ""));
		else
			sb.AppendLine(fila);
	}
}
files = Directory.GetFiles(rutaModules);
foreach (string file in files)
{	
	filas = File.ReadAllLines(file);
	foreach (string fila in filas) {
		if(minificar)
			sb.Append(fila.Replace("\r\n","").Replace("\n","").Replace("\t", ""));
		else
			sb.AppendLine(fila);
	}
}#>
<#=sb.ToString()#>